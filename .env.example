# Source: Database A
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=3306
SOURCE_DB_USER=your_user
SOURCE_DB_PASSWORD=your_password
SOURCE_DB_NAME=database_a

# Destination: Finance Database
FINANCE_DB_HOST=localhost
FINANCE_DB_PORT=3306
FINANCE_DB_USER=your_user
FINANCE_DB_PASSWORD=your_password
FINANCE_DB_NAME=finance_db

# Cost Distribution Database (output of the cost_distribution ETL)
COST_DB_HOST=localhost
COST_DB_PORT=3306
COST_DB_USER=your_user
COST_DB_PASSWORD=your_password
COST_DB_NAME=cost_distribution_db

# Source callback table (in SOURCE_DB_NAME)
SOURCE_CALLBACK_TABLE=callback_zahir

# --- Incremental extraction (watermark) ---
# 1 = only pull callbacks newer than the stored watermark (recommended).
# 0 = legacy "N newest per module" extraction (uses ETL_LIMIT_PER_MODULE).
ETL_INCREMENTAL=1
# Re-scan this many minutes before the watermark each run (safety overlap).
ETL_WATERMARK_OVERLAP_MINUTES=5
# First run only (no watermark yet): initial look-back window in days.
ETL_INITIAL_DAYS=45
# Optional explicit first-run start, e.g. 2026-01-01 (or 1970-01-01 = full backfill).
# ETL_INITIAL_SINCE=2026-01-01

# Legacy extraction cap (only used when ETL_INCREMENTAL=0)
ETL_LIMIT_PER_MODULE=200
